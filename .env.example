# ==============================================================================
# Ricoh Shield Headless API - Production Environment Configuration (.env)
# ==============================================================================

# 1. Server & API Configuration
NODE_ENV=production
PORT=3000
DASHBOARD_PASSWORD=change-this-to-a-secure-admin-password
SERVER_SECRET=change-this-to-a-secure-secret-salt-string
CORS_ORIGIN=*

# 2. Discord Bot Configuration (Optional if running bot)
DISCORD_TOKEN=
DISCORD_OWNER_ID=
DISCORD_ADMIN_ROLE_IDS=

# 3. Database & Storage Configuration
# Default path resolves to Database/whitelist.json inside the project or monorepo
DATABASE_FILE_PATH=./Database/whitelist.json

# 4. Cloudflare Tunnel Metadata (Used by deployment scripts)
CLOUDFLARE_TUNNEL_ID=51f06a50-5435-427a-aa8f-6fb311146a37
CLOUDFLARE_HOSTNAME=api.tamammrbeast.my.id
