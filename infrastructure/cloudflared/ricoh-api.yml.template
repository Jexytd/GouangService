# ==============================================================================
# Cloudflare Tunnel Configuration Template for Ricoh Shield API
# Destination: /etc/cloudflared/ricoh-api.yml
# ==============================================================================
# Domain: api.tamammrbeast.my.id
# Target Localhost: http://127.0.0.1:3000
# ==============================================================================

# ID tunnel atau nama tunnel Cloudflare Anda
tunnel: ${TUNNEL_ID}

# Path ke file kredensial JSON tunnel
# Lokasi standar: /etc/cloudflared/${TUNNEL_ID}.json atau /home/ubuntu/.cloudflared/${TUNNEL_ID}.json
credentials-file: /etc/cloudflared/${TUNNEL_ID}.json

# Ingress Rules: Meneruskan traffic publik langsung ke Node.js Express lokal
ingress:
  # 1. Hostname API Publik
  - hostname: api.tamammrbeast.my.id
    service: http://127.0.0.1:3000
    originRequest:
      connectTimeout: 15s
      noTLSVerify: false
      tcpKeepAlive: 30s
      keepAliveConnections: 100
      keepAliveTimeout: 1m30s

  # 2. Catch-all rule (Wajib ada di baris paling bawah)
  - service: http_status:404
